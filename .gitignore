# Clones locales de trabajo de los scripts de trimestre (cada uno es su propio repo git,
# no deben quedar anidados dentro del repo central)
.repos-trimestre-*/
.env
# Resultados de corrección (notas de estudiantes, fuentes exportadas y gráficas): se regeneran con calificador.py
correcciones/resultados/
__pycache__/
# Red de seguridad: nunca versionar notas, informes ni evidencia de estudiantes, aunque alguien
# los guarde fuera de correcciones/resultados/ (el código de los estudiantes vive en .repos-trimestre-*/)
notas*.csv
informe*.md
evidence/
sources/
.pytest_cache/
.venv/

# Parciales por Google Forms: el banco exportado de Moodle trae las respuestas correctas; los specs reales y los IDs de forms nunca se versionan
parciales/banco/
parciales/specs/*.local.json
parciales/resultados/
# Apps Script de los parciales: los ExamData<Target>.gs los genera publicar.py y llevan las respuestas correctas. Lo versionado es
# solo apps-script/Code.gs y appsscript.json. .clasp.json enlaza la carpeta con el proyecto de Google de cada usuario
parciales/apps-script/ExamData*.gs
.clasp.json
