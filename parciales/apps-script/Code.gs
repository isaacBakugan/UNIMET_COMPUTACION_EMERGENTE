/**
 * Builds the Google Form of an exam from EXAM (ExamData.gs, generated by parciales/formulario.py).
 *
 *   createExam()       creates the Form; if this exam (EXAM.key) was already created it only logs the link
 *   createExamAgain()  creates another copy on purpose
 *
 * Run from the Apps Script editor, or `clasp run createExam`. The contract with formulario.py
 * (every field read here is emitted there) is enforced by parciales/tests/test_formulario.py.
 */

const FOLDER_NAME = 'Parciales';
const PROPERTY_PREFIX = 'exam:';

function createExam() {
  return buildExam_(false);
}

function createExamAgain() {
  return buildExam_(true);
}

function buildExam_(force) {
  const properties = PropertiesService.getScriptProperties();
  const knownId = properties.getProperty(PROPERTY_PREFIX + EXAM.key);
  if (knownId && !force) {
    const existing = FormApp.openById(knownId);
    Logger.log('Already created (use createExamAgain to make another copy): ' + existing.getEditUrl());
    return existing.getEditUrl();
  }

  const real = EXAM.mode === 'real';
  const form = FormApp.create(EXAM.title);
  form.setIsQuiz(true)
    .setDescription(EXAM.description)
    .setCollectEmail(real)
    .setRequireLogin(real)
    .setLimitOneResponsePerUser(real)
    .setShuffleQuestions(real)
    .setAllowResponseEdits(false)
    .setShowLinkToRespondAgain(!real)
    .setPublishingSummary(false)
    .setAcceptingResponses(true);

  EXAM.identification.forEach(function (field) {
    const item = form.addTextItem().setTitle(field.title).setRequired(true);
    if (field.help) item.setHelpText(field.help);
    if (field.pattern) {
      item.setValidation(FormApp.createTextValidation()
        .setHelpText(field.help)
        .requireTextMatchesPattern(field.pattern)
        .build());
    }
  });
  // own page: shuffling only reorders the items of one page, so the identification stays first
  if (EXAM.identification.length > 0) form.addPageBreakItem().setTitle('Preguntas');

  const shuffledItemIds = [];
  EXAM.sections.forEach(function (section) {
    // headers would be shuffled away from their questions in a real (shuffled) exam
    if (!real) form.addSectionHeaderItem().setTitle(section.title);
    section.questions.forEach(function (q) {
      q.images.forEach(function (img) {
        const blob = Utilities.newBlob(Utilities.base64Decode(img.data), img.mime, img.name);
        form.addImageItem().setImage(blob).setTitle('Figura de la pregunta siguiente');
      });
      const item = form.addMultipleChoiceItem();
      item.setTitle(q.stem)
        .setRequired(true)
        .setPoints(q.points)
        .setChoices(q.options.map(function (o) {
          return item.createChoice(o.text, o.correct);
        }));
      if (!real) {
        const correct = q.options.filter(function (o) { return o.correct; })[0];
        item.setFeedbackForCorrect(FormApp.createFeedback().setText('Correcto.').build());
        item.setFeedbackForIncorrect(FormApp.createFeedback().setText('La respuesta correcta es: ' + correct.text).build());
      }
      if (q.shuffle_options) shuffledItemIds.push(item.getId());
    });
  });

  const shuffleStatus = optionShuffleStatus_(shuffledItemIds.length);

  const folders = DriveApp.getFoldersByName(FOLDER_NAME);
  DriveApp.getFileById(form.getId()).moveTo(folders.hasNext() ? folders.next() : DriveApp.createFolder(FOLDER_NAME));
  properties.setProperty(PROPERTY_PREFIX + EXAM.key, form.getId());

  const questionCount = EXAM.sections.reduce(function (sum, s) { return sum + s.questions.length; }, 0);
  Logger.log('Form created: ' + form.getTitle() + ' (' + questionCount + ' questions, mode ' + EXAM.mode + ')');
  Logger.log('Edit:      ' + form.getEditUrl());
  Logger.log('Published: ' + form.getPublishedUrl());
  Logger.log('Option shuffle: ' + shuffleStatus);
  return form.getEditUrl();
}

/**
 * FormApp has no method to shuffle the options of a question, and Forms is not an Apps Script advanced
 * service, so this version cannot apply it. It says so instead of staying silent: the template asked for
 * the shuffle, the Form does not have it.
 */
function optionShuffleStatus_(requestedCount) {
  if (requestedCount === 0) return 'off';
  return 'NOT APPLIED (' + requestedCount + ' questions asked for it): turn on "Shuffle option order" by hand';
}
